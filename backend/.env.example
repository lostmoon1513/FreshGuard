
# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO
LOG_JSON=false
DATABASE_URL=sqlite:///./freshguard.db

# Providers. "fake" is for tests only and is rejected in production.
LLM_PROVIDER=gemini              # gemini | groq | fake
SEARCH_PROVIDER=tavily           # tavily | serper | fake

GEMINI_API_KEY=
GROQ_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=

# Models (vendors rename models often; change here, not in code)
GEMINI_MODEL_STANDARD=gemini-3.8-flash
GEMINI_MODEL_LIGHT=gemini-3.5-flash-lite
GROQ_MODEL_STANDARD=llama-3.3-70b-versatile
GROQ_MODEL_LIGHT=llama-3.3-70b-versatile

# Provider behaviour
LLM_TIMEOUT_SECONDS=30
SEARCH_TIMEOUT_SECONDS=20
PROVIDER_MAX_ATTEMPTS=3
SEARCH_CACHE_TTL_SECONDS=21600   # 6 hours; 0 disables the search cache

# Engine limits
MAX_CLAIMS_PER_ANSWER=10
MAX_SEARCH_RESULTS_PER_QUERY=5
MAX_QUERY_RETRIES=1

FETCH_CONTACT=your-email@example.com
FETCH_TIMEOUT_SECONDS=15